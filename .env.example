# Copy to .env.local and fill in. langgraph.json loads .env.local;
# src/app/config.py reads the same file for everything else.

# Required: all LLM + embedding calls go through OpenAI.
OPENAI_API_KEY=sk-...

# Supabase connection. The defaults baked into src/app/config.py are the
# CLI's public local-dev values (they work against `supabase start` out of
# the box), so these are only needed when targeting a hosted project.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SECRET_KEY=sb_secret_...

# Models (defaults shown).
# CHAT_MODEL=gpt-4.1-mini
# DISCOVERY_MODEL=gpt-5.4
# EMBED_MODEL=text-embedding-3-small

# Rocchio relevance-feedback weights.
# ROCCHIO_ALPHA=1.0
# ROCCHIO_BETA=0.75
# ROCCHIO_GAMMA=0.15

# Total extraction rounds allowed per thread (first run + re-extracts).
# MAX_ITERATIONS=3

# Optional: LangSmith tracing for the LangGraph dev server.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
